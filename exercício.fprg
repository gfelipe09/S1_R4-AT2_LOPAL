    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="senha, conf" type="String" array="False" size=""/>
            <output expression="&quot;Cadastre sua senha: &quot;" newline="True"/>
            <input variable="senha"/>
            <output expression="&quot;Confirme a sua senha: &quot;" newline="True"/>
            <input variable="conf"/>
            <if expression="senha == conf">
                <then>
                    <output expression="&quot;Acesso Liberado&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Acesso Negado&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
