    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero inteiro:&quot;" newline="True"/>
            <input variable="num"/>
            <if expression="num % 2 = 0">
                <then>
                    <output expression="num &amp; &quot; &#233; um n&#250;mero par.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="num &amp; &quot; &#233; um n&#250;mero &#237;mpar.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
